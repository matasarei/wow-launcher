#!/bin/bash
# WoW.app display settings tool.
# Usage:
#   wow-settings show
#   wow-settings auto            detect display and set matching resolution
#   wow-settings auto reset      the same, forgetting a Retina choice made by hand
#   wow-settings windowed [WxH]     e.g. wow-settings windowed 1920x1200
#   wow-settings maximized          borderless window filling the screen (default setup)
#   wow-settings fullscreen [WxH]   true fullscreen
#   wow-settings resolution WxH     just change resolution
#   wow-settings retina on|off|auto render at native pixels (sharper, more GPU)
#                                   on/off is remembered (launcher.conf RETINA=) and
#                                   every auto-match keeps it; auto forgets it again
set -e
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
GAME_NAME="$(grep -sE '^GAME=' "$RES/launcher.conf" | head -1 | cut -d= -f2-)"
if [ -n "$GAME_NAME" ] && [ -d "$RES/games/$GAME_NAME" ]; then GAME_DIR="$RES/games/$GAME_NAME"; else GAME_DIR="$RES/game"; fi
CFG="$GAME_DIR/WTF/Config.wtf"
LOADER="$RES/wine/bin/wine"
export WINEPREFIX="$RES/prefix" WINEDEBUG=-all
export HOME="$("$RES/bin/wow-wine-home" || echo "$HOME")"   # not the user's: wine leaves ~/Wine there (see wow-wine-home)
unset ROSETTA_X87_PATH

set_cvar() {
  if grep -qiE "^SET $1 " "$CFG"; then
    sed -i '' -E "s|^SET $1 .*|SET $1 \"$2\"|" "$CFG"
  else
    printf 'SET %s "%s"\n' "$1" "$2" >> "$CFG"
  fi
}
CONF="$RES/launcher.conf"
conf_get() { grep -sE "^$1=" "$CONF" | head -1 | cut -d= -f2-; }
conf_set() {  # conf_set KEY [VALUE] — no value removes the key
  { grep -svE "^$1=" "$CONF"; [ -n "${2:-}" ] && printf '%s=%s\n' "$1" "$2"; } > "$CONF.tmp" || true
  mv "$CONF.tmp" "$CONF"
}
# A Retina choice made by hand (RETINA=on|off) outranks the display: the
# auto-match at every Play would otherwise switch it straight back.
retina_wanted() {  # retina_wanted <display retina-yes/no> → yes/no
  case "$(conf_get RETINA)" in on) echo yes ;; off) echo no ;; *) echo "$1" ;; esac
}
# RetinaMode without starting wine: `wine reg query` costs a wine process and a
# wineserver (~1 s) at every Play and every time the launcher reads its status.
# The prefix's user.reg holds it as text — but only once wineserver has saved
# it, which is seconds (idle) to half a minute (game running) after a write.
# So every write also records the value next to the prefix; while user.reg is
# not newer than that record, the record is what wine holds. Nothing else
# writes RetinaMode (verify --fix goes through __retina-set below). Neither
# file there: ask wine, as before.
USER_REG="$RES/prefix/user.reg"
RETINA_REC="$RES/prefix/.retina-mode"
retina_have() {  # prints RetinaMode as wine has it (Y/N, upper case), empty when unset
  if [ -f "$RETINA_REC" ] && ! [ "$USER_REG" -nt "$RETINA_REC" ]; then
    tr '[:lower:]' '[:upper:]' < "$RETINA_REC"
  elif [ -f "$USER_REG" ]; then
    P='[software\\wine\\mac driver]' awk '
      BEGIN { p = ENVIRON["P"] }
      /^\[/ { in_key = (index(tolower($0), p) == 1); next }
      in_key && /^"RetinaMode"="/ { v = $0; sub(/^"RetinaMode"="/, "", v); sub(/".*/, "", v); print toupper(v); exit }
    ' "$USER_REG"
  else
    "$LOADER" reg query 'HKCU\Software\Wine\Mac Driver' /v RetinaMode 2>/dev/null | tr -d '\r' | awk '/^[[:space:]]*RetinaMode/ {print toupper($NF)}' | tail -1
  fi
}
retina_set() {  # retina_set Y|N
  "$LOADER" reg add 'HKCU\Software\Wine\Mac Driver' /v RetinaMode /t REG_SZ /d "$1" /f >/dev/null 2>&1 \
    && printf '%s\n' "$1" > "$RETINA_REC"
}
get_cvar() { grep -siE "^SET $1 " "$CFG" | sed -E 's/.*"(.*)".*/\1/' | head -1; }
set_res() { [ -n "$1" ] && { [[ "$1" =~ ^[0-9]+x[0-9]+$ ]] || { echo "bad resolution: $1 (use WxH)"; exit 1; }; set_cvar gxResolution "$1"; }; }


detect_display() {  # prints "PIXELSxPIXELS POINTSxPOINTS retina-yes/no" of the main display
  # test hook: lets the test suite run display-dependent logic deterministically
  if [ -n "${WOW_TEST_DISPLAY:-}" ]; then echo "$WOW_TEST_DISPLAY"; return; fi
  # plutil reads the JSON, as in wow-update. Python is no part of macOS: without
  # the Command Line Tools its binary is only the stub that offers to install
  # them, which is what a player who downloaded the app would get.
  # The main display, else the first one found (a Mac with the lid closed and
  # no display marked main still gets matched).
  local J n_gpu n_disp g d at="" px pts pr ret
  J="$(mktemp -t wow-display)" || return 0
  if [ -n "${WOW_TEST_DISPLAY_JSON:-}" ]; then cat "$WOW_TEST_DISPLAY_JSON" > "$J"   # test hook: a saved system_profiler answer
  else system_profiler SPDisplaysDataType -json > "$J" 2>/dev/null || true; fi
  jget() { plutil -extract "$1" raw -o - -- "$J" 2>/dev/null || true; }
  n_gpu="$(jget SPDisplaysDataType)"
  case "$n_gpu" in ''|*[!0-9]*) n_gpu=0 ;; esac
  g=0
  while [ "$g" -lt "$n_gpu" ]; do
    n_disp="$(jget "SPDisplaysDataType.$g.spdisplays_ndrvs")"
    case "$n_disp" in ''|*[!0-9]*) n_disp=0 ;; esac
    d=0
    while [ "$d" -lt "$n_disp" ]; do
      [ -n "$at" ] || at="SPDisplaysDataType.$g.spdisplays_ndrvs.$d"
      if [ "$(jget "SPDisplaysDataType.$g.spdisplays_ndrvs.$d.spdisplays_main")" = spdisplays_yes ]; then
        at="SPDisplaysDataType.$g.spdisplays_ndrvs.$d"; g="$n_gpu"; break
      fi
      d=$((d + 1))
    done
    g=$((g + 1))
  done
  if [ -n "$at" ]; then
    px="$(jget "$at._spdisplays_pixels" | sed 's/ x /x/')"
    pts="$(jget "$at._spdisplays_resolution" | sed 's/@.*//; s/ x /x/; s/[[:space:]]*$//')"
    pr="$(jget "$at.spdisplays_pixelresolution")"
    case "$pr" in *Retina*) ret=yes ;; *) ret=no ;; esac
    [ -n "$px" ] && [ -n "$pts" ] && [ "$px" != "$pts" ] && ret=yes
    # both sizes or nothing: the caller reads three fields, and a missing one
    # (an AirPlay or virtual display) would shift the rest into the wrong place
    [ -n "$px" ] && [ -n "$pts" ] && echo "$px $pts $ret"
  fi
  rm -f "$J"
}

# RetinaMode lives in the wine prefix, not in the client's Config.wtf — so it is
# matched to the display for every client, including ones whose settings the
# wrapper otherwise leaves alone (verify checks it for every client too).
auto_retina() {  # auto_retina <retina-yes/no>
  local RET WANT HAVE WHY
  [ -n "$1" ] || return 1
  RET="$(retina_wanted "$1")"
  [ "$RET" = yes ] && WANT=Y || WANT=N
  HAVE="$(retina_have)"
  if [ "${HAVE:-N}" != "$WANT" ]; then
    retina_set "$WANT"
    if [ -n "$(conf_get RETINA)" ]; then WHY="set by hand"
    elif [ "$1" = yes ]; then WHY="display is retina"; else WHY="display is non-retina"; fi
    echo "retina mode -> $([ "$WANT" = Y ] && echo on || echo off) ($WHY)"
  fi
}

auto_resolution() {
  read -r PX PTS RET <<< "$(detect_display)"
  [ -n "$PX" ] || { echo "could not detect display"; return 1; }
  auto_retina "$RET"
  RET="$(retina_wanted "$RET")"   # the resolution follows the Retina setting in force
  if [ "$RET" = yes ]; then TARGET="$PX"; MODE_DESC="retina/native"; else TARGET="$PTS"; MODE_DESC="standard"; fi
  CUR="$(get_cvar gxResolution)"
  if [ "$CUR" = "$TARGET" ]; then
    echo "resolution already $TARGET ($MODE_DESC)"
  else
    set_cvar gxResolution "$TARGET"
    echo "resolution set to $TARGET ($MODE_DESC, was $CUR)"
  fi
}

case "$1" in
  __detect)
    detect_display ;;
  __retina-set)   # for verify --fix: a write that keeps the record above true
    case "$2" in Y|N) retina_set "$2" ;; *) echo "usage: wow-settings __retina-set Y|N"; exit 1 ;; esac ;;
  auto|"")
    [ "${2:-}" = reset ] && conf_set RETINA
    auto_resolution ;;
  show)
    echo "mode:       $([ "$(get_cvar gxWindow)" = 0 ] && echo fullscreen || { [ "$(get_cvar gxMaximize)" = 1 ] && echo 'windowed (maximized)' || echo windowed; })"
    echo "resolution: $(get_cvar gxResolution)"
    echo "retina:     $(retina_have | grep -q Y && echo on || echo off)"
    ;;
  windowed)   set_cvar gxWindow 1; set_cvar gxMaximize 0; set_res "$2"; echo "windowed${2:+ at $2} — restart the game" ;;
  maximized)  set_cvar gxWindow 1; set_cvar gxMaximize 1; echo "maximized — restart the game" ;;
  fullscreen) set_cvar gxWindow 0; set_cvar gxMaximize 0; set_res "$2"; echo "fullscreen${2:+ at $2} — restart the game" ;;
  resolution) set_res "$2"; [ -n "$2" ] || { echo "usage: wow-settings resolution WxH"; exit 1; }; echo "resolution $2 — restart the game" ;;
  retina)
    case "$2" in
      auto)
        conf_set RETINA
        read -r _PX _PTS RET <<< "$(detect_display)"
        auto_retina "$RET" || { echo "could not detect display"; exit 1; }
        echo "retina mode matched to the display" ;;
      on)  conf_set RETINA on;  retina_set Y; echo "retina on — restart the game (consider a higher resolution too)" ;;
      off) conf_set RETINA off; retina_set N; echo "retina off — restart the game" ;;
      *) echo "usage: wow-settings retina on|off|auto"; exit 1 ;;
    esac ;;
  *) grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

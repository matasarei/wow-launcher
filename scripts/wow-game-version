#!/bin/bash
# Detect the WoW client version of a game folder.
# Thin front end for wow-client-profile: prints the canonical label of a client
# the launcher knows ("3.3.5a", "2.4.3", "1.12"), otherwise whatever version the
# client's own executable declares (e.g. "4.3.4"); prints "unknown" and exits 1
# when neither the Data layout nor the executable says anything.
D="${1:?usage: wow-game-version /path/to/game}"
V="$("$(dirname "$0")/wow-client-profile" "$D" | grep -E '^VERSION=' | cut -d= -f2-)"
case "$V" in
  ""|unknown) echo unknown; exit 1 ;;
  *) echo "$V" ;;
esac

#!/bin/bash
# Verify the active game can run: files in place, patches applied, settings sane.
# Version-aware: 3.3.5a, 2.4.3 and 1.12 clients have different check lists.
# Usage: wow-verify-game [--fix]
#   --fix repairs everything repairable: patch-stack files are restored from the
#   patch kit, settings (Config.wtf cvars, RetinaMode, fast-exit fix) rewritten.
# Protocol: "PROGRESS <n> <total> <label>" before each check, ok:/WARN:/FAIL: results,
# "CANFIX" if fixable failures were found (check mode), "REINSTALL" if the game
# data itself is damaged (not repairable — reinstall the client), final RESULT: line.
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
KIT="$RES/patch-kit"
BIN="$RES/bin"
GAME_NAME="$(grep -sE '^GAME=' "$RES/launcher.conf" | head -1 | cut -d= -f2-)"
if [ -n "$GAME_NAME" ] && [ -d "$RES/games/$GAME_NAME" ]; then G="$RES/games/$GAME_NAME"; else G="$RES/game"; fi
[ -d "$G" ] || { echo "FAIL: no game installed"; echo "REINSTALL"; echo "RESULT: PROBLEMS"; exit 1; }
FIX=0; [ "$1" = "--fix" ] && FIX=1
fail=0; warn=0; canfix=0; reinstall=0; i=0
CFG="$G/WTF/Config.wtf"
LOADER="$RES/wine/bin/wine"
export WINEPREFIX="$RES/prefix" WINEDEBUG=-all

V="$(grep -sE '^GAME_VERSION=' "$RES/launcher.conf" | cut -d= -f2)"
[ -n "$V" ] || V="$("$BIN/wow-game-version" "$G" 2>/dev/null || echo unknown)"
case "$V" in
  3.3.5a) TOTAL=43; SUPPORT_DLLS="ijl15.dll dbghelp.dll unicows.dll Battle.net.dll Scan.dll"
          CORE_MPQS="common.MPQ common-2.MPQ expansion.MPQ lichking.MPQ patch.MPQ patch-2.MPQ"
          SILICON_SUB="wotlk" ;;
  2.4.3)  TOTAL=29; SUPPORT_DLLS="ijl15.dll unicows.dll"
          CORE_MPQS="common.MPQ expansion.MPQ patch.MPQ"
          SILICON_SUB="" ;;
  1.12)   TOTAL=25; SUPPORT_DLLS="ijl15.dll unicows.dll"
          CORE_MPQS="dbc.MPQ interface.MPQ model.MPQ texture.MPQ"
          SILICON_SUB="vanilla" ;;
  *) echo "FAIL: unrecognized client version"; echo "REINSTALL"; echo "RESULT: PROBLEMS"; exit 1 ;;
esac
# The client's entrypoint. Sirus-style custom clients ship run.exe and no
# Wow.exe; when both exist Wow.exe wins (it is the renamed copy people make).
game_exe() {  # game_exe <game dir>
  [ -f "$1/Wow.exe" ] && { echo Wow.exe; return; }
  [ -f "$1/run.exe" ] && { echo run.exe; return; }
  echo Wow.exe
}
EXE="$(game_exe "$G")"

# Patch level (launcher.conf PATCHES=, Game pane picker), migrating the pre-2.4
# SILICON= toggle (1 -> all, 0 -> no-silicon). Each level defines the expected
# state of the mod loader, libSiliconPatch and the Wow.exe icon patch; --fix
# converges the game folder to it in both directions.
patch_level() {
  local p
  p="$(grep -sE '^PATCHES=' "$RES/launcher.conf" | cut -d= -f2)"
  case "$p" in all|no-silicon|winerosetta|none) echo "$p"; return ;; esac
  case "$(grep -sE '^SILICON=' "$RES/launcher.conf" | cut -d= -f2)" in
    0) echo no-silicon ;;
    *) echo all ;;
  esac
}
PATCHES="$(patch_level)"
case "$PATCHES" in
  all)         WANT_LOADER=1; WANT_SILICON=1; WANT_ICON=1 ;;
  no-silicon)  WANT_LOADER=1; WANT_SILICON=0; WANT_ICON=1 ;;
  winerosetta) WANT_LOADER=1; WANT_SILICON=0; WANT_ICON=0 ;;
  none)        WANT_LOADER=0; WANT_SILICON=0; WANT_ICON=0 ;;
esac
[ -n "$SILICON_SUB" ] || WANT_SILICON=0   # no libSiliconPatch build for this client
# "No patches" is the level people pick for custom clients, so not recognising the
# build is expected there — report it, but do not raise warnings nobody can act on.
LENIENT=0; [ "$PATCHES" = none ] && LENIENT=1
if [ "$WANT_SILICON" = 1 ]; then DLLS_TXT="$(printf 'mods/winerosetta.dll\nmods/libSiliconPatch.dll\n')"
elif [ "$WANT_LOADER" = 1 ]; then DLLS_TXT="mods/winerosetta.dll"
else DLLS_TXT=""; fi

step() { i=$((i+1)); echo "PROGRESS $i $TOTAL $1"; }
get_cvar() { grep -iE "^SET $1 " "$CFG" 2>/dev/null | sed -E 's/.*"(.*)".*/\1/' | head -1; }
set_cvar() {
  mkdir -p "$G/WTF"
  if grep -qsiE "^SET $1 " "$CFG"; then sed -i '' -E "s|^SET $1 .*|SET $1 \"$2\"|" "$CFG"
  else printf 'SET %s "%s"\n' "$1" "$2" >> "$CFG"; fi
}

need_core() {  # unrepairable client file
  step "$2"
  if [ -e "$G/$1" ]; then echo "ok: $2"
  else echo "FAIL: $2 missing ($1)"; fail=$((fail+1)); reinstall=1; fi
}
optional() {
  step "$2"
  if [ -e "$G/$1" ]; then echo "ok: $2"; else echo "WARN: $2 not present ($1)"; warn=$((warn+1)); fi
}
noted() {  # informational: a custom client may legitimately not ship this
  step "$2"
  if [ -e "$G/$1" ]; then echo "ok: $2"; else echo "ok: $2 not present (custom client)"; fi
}
from_kit() {  # restorable from patch kit: from_kit <game rel> <kit rel> <label>
  step "$3"
  if cmp -s "$G/$1" "$KIT/$2"; then echo "ok: $3"; return; fi
  if [ "$FIX" = 1 ]; then
    mkdir -p "$(dirname "$G/$1")"
    if cp "$KIT/$2" "$G/$1" 2>/dev/null; then echo "ok: $3 (fixed)"; else echo "FAIL: $3 could not be restored"; fail=$((fail+1)); fi
  else
    echo "FAIL: $3 missing or modified — repairable"; fail=$((fail+1)); canfix=1
  fi
}

# --- game executable --- (2 steps)
step "$EXE present"
if [ -f "$G/$EXE" ]; then echo "ok: $EXE present"
elif [ "$V" = "3.3.5a" ] && [ -f "$KIT/Wow.exe.icon-patched" ] && [ "$FIX" = 1 ]; then
  cp "$KIT/Wow.exe.icon-patched" "$G/Wow.exe" && echo "ok: Wow.exe present (restored)" || { echo "FAIL: Wow.exe missing"; fail=$((fail+1)); }
else echo "FAIL: $EXE missing"; fail=$((fail+1)); reinstall=1; fi
# The cosmetic icon patch follows the level in BOTH directions: reverted from the
# in-game backup at winerosetta/none, re-applied from the kit at all/no-silicon.
icon_possible() {  # true only when the exe is currently unpatched and a patch exists
  local CUR D B
  [ -f "$KIT/Wow.exe.icon-patched" ] && [ -f "$KIT/Wow.exe.orig" ] \
    && cmp -s "$G/Wow.exe" "$KIT/Wow.exe.orig" && return 0
  [ -x /usr/bin/bspatch ] || return 1
  CUR="$(md5 -q "$G/Wow.exe" 2>/dev/null)"
  for D in "$KIT"/wow-icon-*.bsdiff; do
    [ -f "$D" ] || continue
    B="$(basename "$D" .bsdiff)"; B="${B#wow-icon-}"
    [ "$CUR" = "${B%%-*}" ] && return 0
  done
  return 1
}
apply_icon() {  # keeps Wow.exe.icon-backup in step with what it replaces
  local CUR D B OUTMD5
  if [ -f "$KIT/Wow.exe.icon-patched" ] && [ -f "$KIT/Wow.exe.orig" ] \
     && cmp -s "$G/Wow.exe" "$KIT/Wow.exe.orig"; then
    cp "$G/Wow.exe" "$G/Wow.exe.icon-backup" && cp "$KIT/Wow.exe.icon-patched" "$G/Wow.exe" \
      && chmod +x "$G/Wow.exe" && return 0
    return 1
  fi
  [ -x /usr/bin/bspatch ] || return 1
  CUR="$(md5 -q "$G/Wow.exe" 2>/dev/null)"
  for D in "$KIT"/wow-icon-*.bsdiff; do
    [ -f "$D" ] || continue
    B="$(basename "$D" .bsdiff)"; B="${B#wow-icon-}"; OUTMD5="${B#*-}"
    [ "$CUR" = "${B%%-*}" ] || continue
    /usr/bin/bspatch "$G/Wow.exe" "$G/Wow.exe.icon-new" "$D" 2>/dev/null || true
    if [ "$(md5 -q "$G/Wow.exe.icon-new" 2>/dev/null)" = "$OUTMD5" ]; then
      cp "$G/Wow.exe" "$G/Wow.exe.icon-backup"
      mv "$G/Wow.exe.icon-new" "$G/Wow.exe"; chmod +x "$G/Wow.exe"; return 0
    fi
    rm -f "$G/Wow.exe.icon-new"; return 1
  done
  return 1
}
step "$EXE build check"
ICON_ORIG=""
[ -f "$G/Wow.exe.icon-backup" ] && ICON_ORIG="$G/Wow.exe.icon-backup"
[ -z "$ICON_ORIG" ] && [ -f "$KIT/Wow.exe.orig" ] && ICON_ORIG="$KIT/Wow.exe.orig"
if [ "$EXE" != "Wow.exe" ]; then
  echo "ok: $EXE is a custom client entrypoint (no reference build, not patched)"
elif [ "$WANT_ICON" = 1 ] && icon_possible; then
  if [ "$FIX" = 1 ]; then
    if apply_icon; then echo "ok: Wow.exe icon patch (fixed)"
    else echo "WARN: Wow.exe icon patch could not be applied (cosmetic)"; warn=$((warn+1)); fi
  else
    echo "FAIL: Wow.exe icon patch missing for patch level '$PATCHES' — repairable"; fail=$((fail+1)); canfix=1
  fi
elif [ "$WANT_ICON" = 0 ] && [ -n "$ICON_ORIG" ] && ! cmp -s "$G/Wow.exe" "$ICON_ORIG"; then
  if [ "$FIX" = 1 ]; then
    cp "$ICON_ORIG" "$G/Wow.exe" && chmod +x "$G/Wow.exe" \
      && echo "ok: Wow.exe restored to the original (fixed)" \
      || { echo "FAIL: Wow.exe could not be restored"; fail=$((fail+1)); }
  else
    echo "FAIL: Wow.exe is icon-patched but the patch level is '$PATCHES' — repairable"; fail=$((fail+1)); canfix=1
  fi
elif [ "$V" = "3.3.5a" ] && { [ -f "$KIT/Wow.exe.orig" ] || [ -f "$KIT/Wow.exe.icon-patched" ]; }; then
  if cmp -s "$G/Wow.exe" "$KIT/Wow.exe.icon-patched" || cmp -s "$G/Wow.exe" "$KIT/Wow.exe.orig"; then
    echo "ok: Wow.exe is the known 3.3.5a (12340) build"
  else
    if [ "$LENIENT" = 1 ]; then echo "ok: Wow.exe is not the stock 3.3.5a build (expected with no patches)"
    else echo "WARN: Wow.exe differs from the known 3.3.5a build"; warn=$((warn+1)); fi
  fi
else
  echo "ok: Wow.exe ($V client, no reference build to compare against)"
fi

# --- support libraries the client ships (not in kit) ---
# (3.3.5a: 5 steps; others: 2 steps — as warnings, older clients vary more)
for dll in $SUPPORT_DLLS; do
  if [ "$V" = "3.3.5a" ] && [ "$LENIENT" = 0 ] && [ "$EXE" = "Wow.exe" ]; then need_core "$dll" "$dll"
  elif [ "$LENIENT" = 1 ] || [ "$EXE" != "Wow.exe" ]; then noted "$dll" "$dll"
  else optional "$dll" "$dll"; fi
done

# --- Apple Silicon patch stack (all restorable) --- (10 steps)
check_divx() {  # check_divx <dll name> — 1 step
  # NB: separate `local` calls — bash expands all words of one `local` before
  # assigning any of them, so $DLL is not yet set within its own declaration.
  local DLL="$1"
  local PATCHED="$KIT/$DLL.$V.patched" ORIG="$KIT/$DLL.$V.orig" REF=""
  step "$DLL mod loader"
  if [ ! -f "$G/$DLL" ] && [ ! -f "$G/$DLL.bak" ]; then
    echo "ok: $DLL not present in this client (not applicable)"
  elif [ "$WANT_LOADER" = 0 ]; then
    # the level wants the untouched DLL back
    [ -f "$G/$DLL.bak" ] && REF="$G/$DLL.bak"
    [ -z "$REF" ] && [ -f "$ORIG" ] && REF="$ORIG"
    if [ -z "$REF" ]; then
      # only reachable at PATCHES=none, where an unrecognised client is expected:
      # claim only what is true — this app did not patch it — and stay quiet
      echo "ok: $DLL never patched by the launcher (no original copy to compare against)"
    elif cmp -s "$G/$DLL" "$REF"; then echo "ok: $DLL is the original (no patches)"
    elif [ "$FIX" = 1 ]; then
      cp "$REF" "$G/$DLL" && echo "ok: $DLL restored (fixed)" || { echo "FAIL: $DLL"; fail=$((fail+1)); }
    else
      echo "FAIL: $DLL is patched but the patch level is 'none' — repairable"; fail=$((fail+1)); canfix=1
    fi
  elif [ ! -f "$PATCHED" ]; then
    if [ -f "$G/$DLL.bak" ] && ! cmp -s "$G/$DLL" "$G/$DLL.bak"; then
      echo "ok: $DLL performance patch (verified against local backup)"
    else
      echo "WARN: cannot verify $DLL patch (no reference; reinstall the game to apply it)"; warn=$((warn+1))
    fi
  elif cmp -s "$G/$DLL" "$PATCHED"; then
    echo "ok: $DLL performance patch"
  elif [ "$FIX" = 1 ]; then
    [ -f "$G/$DLL" ] && cp "$G/$DLL" "$G/$DLL.bak" 2>/dev/null
    cp "$PATCHED" "$G/$DLL" && echo "ok: $DLL performance patch (fixed)" || { echo "FAIL: $DLL"; fail=$((fail+1)); }
  else
    echo "FAIL: $DLL performance patch inactive — repairable"; fail=$((fail+1)); canfix=1
  fi
}
check_divx DivxDecoder.dll
check_divx DivxTac.dll
from_kit d3d9.dll d3d9.dll "d3d9.dll (DXVK renderer)"
from_kit libDllLdr.dll libDllLdr.dll "libDllLdr.dll"
step "dlls.txt"
if [ -z "$DLLS_TXT" ]; then
  if [ ! -f "$G/dlls.txt" ]; then echo "ok: dlls.txt absent (no patches)"
  elif [ "$FIX" = 1 ]; then rm -f "$G/dlls.txt"; echo "ok: dlls.txt removed (fixed)"
  else echo "FAIL: dlls.txt present but the patch level is 'none' — repairable"; fail=$((fail+1)); canfix=1; fi
elif [ "$(cat "$G/dlls.txt" 2>/dev/null)" = "$DLLS_TXT" ]; then echo "ok: dlls.txt"
elif [ "$FIX" = 1 ]; then
  printf '%s\n' "$DLLS_TXT" > "$G/dlls.txt"
  echo "ok: dlls.txt (fixed)"
else echo "FAIL: dlls.txt missing or does not match the mod set — repairable"; fail=$((fail+1)); canfix=1; fi
if [ "$WANT_LOADER" = 1 ]; then
  from_kit mods/winerosetta.dll mods/winerosetta.dll "winerosetta.dll"
else
  # left on disk but never loaded: nothing reads dlls.txt once Divx is unpatched
  step "winerosetta.dll"; echo "ok: winerosetta.dll not loaded (no patches)"
fi
step "libSiliconPatch.dll"
if [ "$WANT_SILICON" = 0 ] && [ -n "$SILICON_SUB" ]; then
  echo "ok: libSiliconPatch off (patch level: $PATCHES)"
elif [ -z "$SILICON_SUB" ]; then
  echo "ok: libSiliconPatch not used for $V clients"
elif cmp -s "$G/mods/libSiliconPatch.dll" "$KIT/libSiliconPatch/$SILICON_SUB/libSiliconPatch.dll"; then
  echo "ok: libSiliconPatch.dll ($SILICON_SUB)"
elif [ "$FIX" = 1 ]; then
  mkdir -p "$G/mods"
  cp "$KIT/libSiliconPatch/$SILICON_SUB/libSiliconPatch.dll" "$G/mods/" && echo "ok: libSiliconPatch.dll (fixed)" || { echo "FAIL: libSiliconPatch.dll"; fail=$((fail+1)); }
else echo "FAIL: libSiliconPatch.dll missing or modified — repairable"; fail=$((fail+1)); canfix=1; fi
from_kit rosettax87/rosettax87 rosettax87/rosettax87 "rosettax87"
from_kit rosettax87/libRuntimeRosettax87 rosettax87/libRuntimeRosettax87 "libRuntimeRosettax87"
from_kit rosettax87/rosettax87-shim rosettax87/rosettax87-shim "rosettax87 Dock-name shim"

# --- core data archives (not repairable) ---
# (3.3.5a: 7 steps; 2.4.3: 3; 1.12: 4)
for mpq in $CORE_MPQS; do
  need_core "Data/$mpq" "Data/$mpq"
done
[ "$V" = "3.3.5a" ] && optional "Data/patch-3.MPQ" "Data/patch-3.MPQ"

# --- locale data & realmlist ---
# (3.3.5a: 13 steps; 2.4.3: 6; 1.12: 1)
LOCALE="$(basename "$(ls -d "$G"/Data/????/ 2>/dev/null | head -1)" 2>/dev/null)"
check_realmlist() {  # check_realmlist <path> — 1 step
  step "realmlist.wtf"
  if [ -f "$1" ]; then echo "ok: realmlist.wtf"
  else echo "FAIL: realmlist.wtf missing ($1)"; fail=$((fail+1)); reinstall=1; fi
}
if [ "$V" = "1.12" ]; then
  REALMLIST="$G/realmlist.wtf"
  check_realmlist "$REALMLIST"
else
  REALMLIST="$G/Data/$LOCALE/realmlist.wtf"
  step "locale folder"
  if [ -n "$LOCALE" ]; then
    echo "ok: locale $LOCALE"
    check_realmlist "$REALMLIST"
    if [ "$V" = "3.3.5a" ]; then
      for m in locale speech base backup expansion-locale expansion-speech lichking-locale lichking-speech; do
        need_core "Data/$LOCALE/$m-$LOCALE.MPQ" "$m-$LOCALE.MPQ"
      done
      need_core "Data/$LOCALE/patch-$LOCALE.MPQ" "patch-$LOCALE.MPQ"
      need_core "Data/$LOCALE/patch-$LOCALE-2.MPQ" "patch-$LOCALE-2.MPQ"
      optional "Data/$LOCALE/patch-$LOCALE-3.MPQ" "patch-$LOCALE-3.MPQ"
    else
      need_core "Data/$LOCALE/locale-$LOCALE.MPQ" "locale-$LOCALE.MPQ"
      need_core "Data/$LOCALE/expansion-locale-$LOCALE.MPQ" "expansion-locale-$LOCALE.MPQ"
      need_core "Data/$LOCALE/patch-$LOCALE.MPQ" "patch-$LOCALE.MPQ"
      optional "Data/$LOCALE/speech-$LOCALE.MPQ" "speech-$LOCALE.MPQ"
    fi
  else
    echo "FAIL: no locale folder in Data"; fail=$((fail+1)); reinstall=1
    if [ "$V" = "3.3.5a" ]; then PAD=12; else PAD=5; fi
    for _ in $(seq 1 $PAD); do step "locale data"; echo "WARN: skipped (no locale)"; done
    warn=$((warn+1))
  fi
fi

# --- settings --- (6 steps)
step "renderer API (gxApi)"
API="$(get_cvar gxApi | tr A-Z a-z)"
if [ -z "$API" ] || [ "$API" = "d3d9" ]; then echo "ok: renderer API is Direct3D 9"
elif [ "$FIX" = 1 ]; then set_cvar gxApi D3D9; echo "ok: renderer API is Direct3D 9 (fixed)"
else echo "FAIL: renderer API is '$API', DXVK needs d3d9 — repairable"; fail=$((fail+1)); canfix=1; fi

DETECT="$("$BIN/wow-settings" __detect 2>/dev/null)"
read -r PX PTS RET <<< "$DETECT"
step "resolution matches display"
AUTO="$(grep -sE '^AUTO_RES=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "${AUTO:-1}" != "1" ]; then
  echo "ok: resolution (auto-match off, user managed)"
elif [ -z "$PX" ]; then
  echo "WARN: could not detect display"; warn=$((warn+1))
else
  [ "$RET" = yes ] && TARGET="$PX" || TARGET="$PTS"
  CUR="$(get_cvar gxResolution)"
  if [ "$CUR" = "$TARGET" ]; then echo "ok: resolution $CUR matches display"
  elif [ "$FIX" = 1 ]; then "$BIN/wow-settings" auto >/dev/null 2>&1; echo "ok: resolution set to $TARGET (fixed)"
  else echo "FAIL: resolution is '$CUR', display wants $TARGET — repairable"; fail=$((fail+1)); canfix=1; fi
fi

step "retina mode matches display"
if [ -z "$RET" ]; then
  echo "WARN: could not detect display"; warn=$((warn+1))
else
  [ "$RET" = yes ] && WANT=Y || WANT=N
  HAVE="$("$LOADER" reg query 'HKCU\Software\Wine\Mac Driver' /v RetinaMode 2>/dev/null | tr -d '\r' | awk '/^[[:space:]]*RetinaMode/ {print toupper($NF)}' | tail -1)"
  if [ "${HAVE:-N}" = "$WANT" ]; then echo "ok: retina mode matches display"
  elif [ "$FIX" = 1 ]; then "$LOADER" reg add 'HKCU\Software\Wine\Mac Driver' /v RetinaMode /t REG_SZ /d "$WANT" /f >/dev/null 2>&1; echo "ok: retina mode (fixed)"
  else echo "FAIL: retina mode is '${HAVE:-unset}', display wants $WANT — repairable"; fail=$((fail+1)); canfix=1; fi
fi

step "realmList setting matches server"
ACTIVE="$(grep -ihE '^[[:space:]]*set[[:space:]]+realmlist[[:space:]]' "$REALMLIST" 2>/dev/null | head -1 | awk '{print $3}')"
CV="$(get_cvar realmList)"
if [ -z "$ACTIVE" ] || [ -z "$CV" ] || [ "$CV" = "$ACTIVE" ]; then echo "ok: realmList setting"
elif [ "$FIX" = 1 ]; then set_cvar realmList "$ACTIVE"; echo "ok: realmList set to $ACTIVE (fixed)"
else echo "FAIL: Config realmList '$CV' differs from selected server '$ACTIVE' — repairable"; fail=$((fail+1)); canfix=1; fi

step "fast-exit network fix"
IS='HKCU\Software\Microsoft\Windows\CurrentVersion\Internet Settings'
PS="$("$LOADER" reg query "$IS" /v ProxyServer 2>/dev/null | tr -d '\r')"
PE="$("$LOADER" reg query "$IS" /v ProxyEnable 2>/dev/null | tr -d '\r')"
if echo "$PS" | grep -q '127\.0\.0\.1:1' && echo "$PE" | grep -qi '0x1'; then
  echo "ok: fast-exit network fix active"
elif [ "$FIX" = 1 ]; then
  "$LOADER" reg add "$IS" /v ProxyServer /t REG_SZ /d '127.0.0.1:1' /f >/dev/null 2>&1
  "$LOADER" reg add "$IS" /v ProxyEnable /t REG_DWORD /d 1 /f >/dev/null 2>&1
  echo "ok: fast-exit network fix (fixed)"
else
  echo "FAIL: fast-exit network fix missing (game hangs ~5 min on exit) — repairable"; fail=$((fail+1)); canfix=1
fi

step "WTF/Config.wtf"
if [ -f "$CFG" ]; then echo "ok: WTF/Config.wtf"
else echo "WARN: Config.wtf not present (created on first run)"; warn=$((warn+1)); fi

[ "$canfix" -gt 0 ] && [ "$FIX" = 0 ] && echo "CANFIX"
[ "$reinstall" -gt 0 ] && echo "REINSTALL"
if [ "$fail" -gt 0 ]; then
  echo "RESULT: PROBLEMS — $fail check(s) failed"
  exit 1
elif [ "$warn" -gt 0 ]; then
  echo "RESULT: OK with $warn warning(s)"
else
  echo "RESULT: OK — all checks passed"
fi

#!/bin/bash
# Internal game launcher — invoked by the WoW335 manager GUI (Play button).
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
GAME="$RES/game"
LOADER="$RES/cxwine/CrossOver-Hosted Application/wineloader2"
LOG="$RES/logs/last-launch.log"
export WINEPREFIX="$RES/prefix"
export ROSETTA_X87_PATH="$GAME/rosettax87/rosettax87"
export WINEDLLOVERRIDES="d3d9=n,b"
export MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=1
export DXVK_ASYNC=1
export MTL_HUD_ENABLED=0
export WINEDEBUG=-all
cd "$GAME" || exit 1
# Auto-match the game resolution to the current display, unless disabled in launcher.conf
AUTO=$(grep -sE '^AUTO_RES=' "$RES/launcher.conf" | cut -d= -f2)
if [ "${AUTO:-1}" = "1" ]; then
  "$RES/bin/wow-settings" auto >> "$LOG.settings" 2>&1 || true
fi
nohup "$LOADER" "$GAME/Wow.exe" > "$LOG" 2>&1 &
disown
exit 0

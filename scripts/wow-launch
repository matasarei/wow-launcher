#!/bin/bash
# Internal game launcher — invoked by the WoW Launcher manager GUI (Play button).
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
GAME_NAME="$(grep -sE '^GAME=' "$RES/launcher.conf" | head -1 | cut -d= -f2-)"
if [ -n "$GAME_NAME" ] && [ -d "$RES/games/$GAME_NAME" ]; then GAME="$RES/games/$GAME_NAME"; else GAME="$RES/game"; fi
LOADER="$RES/wine/bin/wine"
LOG="$RES/logs/last-launch.log"
# Without Rosetta the x86_64 loader cannot exec at all: nohup would write "Bad
# CPU type in executable" into the log and the game would never appear.
if ! WHY="$("$RES/bin/wow-check-rosetta")"; then
  { echo "$WHY"; echo "ERROR: the game cannot start without Rosetta 2"; } | tee "$LOG"
  exit 1
fi
export WINEPREFIX="$RES/prefix"
export HOME="$("$RES/bin/wow-wine-home" || echo "$HOME")"   # not the user's: wine leaves ~/Wine there (see wow-wine-home)
# Wine creates the game's sockets inside wineserver, and macOS credits network
# traffic to the app that started *that* process. A wineserver left over from
# an earlier session has outlived its launcher and is responsible only for
# itself — an unsigned binary with no Local Network grant — so a game reusing
# it can never reach a LAN realm. Start every session with a fresh one, unless
# a game from this copy is still running on it.
# Matched as literal text on this copy's whole game path: another copy of the
# app has its own games/main, and its game must not stop this one cleaning up.
# rosettax87 shows the path with slashes, Wine's Wow.exe as Z:\… backslashes.
WIN_GAME="Z:$(printf '%s' "$GAME" | tr '/' '\\')"
PROCS="$(ps -wwaxo command=)"   # listed first: a grep in the same pipeline would match itself
if ! printf '%s\n' "$PROCS" | grep -qF -e "$GAME/" -e "$WIN_GAME\\"; then
  "$RES/wine/bin/wineserver" -k >/dev/null 2>&1 || true
fi
# the Z: drive link is stripped at build time (absolute symlinks break codesign)
[ -e "$RES/prefix/dosdevices/z:" ] || ln -sf / "$RES/prefix/dosdevices/z:" 2>/dev/null
# x87 engine (launcher.conf X87=): rosettax87 (default) or sidecar — the newer
# cooperative variant (no debugger attach); a fallback if rosettax87 breaks on
# a future macOS. The shim reroutes the loader exec through the 'WoW' symlink
# so the game's Dock entry shows "WoW" instead of "wine".
X87="$(grep -sE '^X87=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "$X87" = "sidecar" ] && [ -x "$RES/patch-kit/x87sidecar/x87sidecar" ]; then
  export X87_SIDECAR_PATH="$RES/patch-kit/x87sidecar/x87sidecar"
elif [ -x "$GAME/rosettax87/rosettax87-shim" ]; then
  export ROSETTA_X87_PATH="$GAME/rosettax87/rosettax87-shim"
else
  export ROSETTA_X87_PATH="$GAME/rosettax87/rosettax87"
fi
# Renderer (launcher.conf RENDERER=): dxvk (default) loads the game-dir DXVK
# d3d9.dll; mtld3d uses the runtime's builtin d3d9, which IS the MTLd3D
# Metal-native backend (HDR-capable).
RENDERER="$(grep -sE '^RENDERER=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "$RENDERER" = "mtld3d" ]; then
  export WINEDLLOVERRIDES="d3d9=b"
else
  export WINEDLLOVERRIDES="d3d9=n,b"
  # DXVK draws through Vulkan. From runtime r16 the Vulkan library is the
  # Khronos loader, with MoltenVK as one of the drivers in lib/vulkan/icd.d —
  # not among the macOS loader's default search paths, so left to itself it
  # may find no driver, or one from a Vulkan SDK installed on the Mac (read
  # from the loader's documented search order, not reproduced). Named
  # explicitly, as upstream does; an older runtime (MoltenVK itself as the
  # library) has no manifest, and then nothing is set.
  ICD="$RES/wine/lib/vulkan/icd.d/MoltenVK_icd.json"
  if [ -f "$ICD" ]; then export VK_DRIVER_FILES="$ICD"; else unset VK_DRIVER_FILES; fi
fi
export MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=1
export DXVK_ASYNC=1
export WINE_LARGE_ADDRESS_AWARE=1
export MTL_HUD_ENABLED=0
export WINEDEBUG=-all
# Audio (runtime r15+, WoWSilicon's winecoreaudio patch): the driver follows the
# macOS default output device on its own — WOWSILICON_FOLLOW_SYSTEM_OUTPUT stays
# unset (default 1). Apple's spatial mixer and the volume normalizer are on unless
# launcher.conf says SPATIAL_AUDIO=0 / NORMALIZE_AUDIO=0 (absent = on, like
# AUTO_RES); both are exported explicitly so a stale variable in the user's shell
# cannot leak in. The driver also polls two control files for live changes and,
# unless told where, reads them from ~/Library/Application Support/WoWSilicon/ —
# a co-installed WoWSilicon's settings would leak into this wrapper. Point them
# inside the bundle (they need not exist: an unreadable file falls back to the
# environment value).
SPATIAL_AUDIO="$(grep -sE '^SPATIAL_AUDIO=' "$RES/launcher.conf" | cut -d= -f2)"
NORMALIZE_AUDIO="$(grep -sE '^NORMALIZE_AUDIO=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "${SPATIAL_AUDIO:-1}" = "1" ]; then export WOWSILICON_SPATIAL_AUDIO_MODE=fixed; else export WOWSILICON_SPATIAL_AUDIO_MODE=off; fi
if [ "${NORMALIZE_AUDIO:-1}" = "1" ]; then export WOWSILICON_NORMALIZE_AUDIO=1; else export WOWSILICON_NORMALIZE_AUDIO=0; fi
export WOWSILICON_SPATIAL_AUDIO_CONTROL="$RES/audio/spatial-audio-mode"
export WOWSILICON_NORMALIZE_AUDIO_CONTROL="$RES/audio/normalize-audio"
# Wine's keyboard input conversion follows the unix locale, and the prefix's
# system codepage must match it (like Windows' "language for non-Unicode
# programs"). Derive both from the game's locale; CHAT_CP=1251 in launcher.conf
# forces the Russian input layer for any client (RU players on enUS clients).
GLOC="$(basename "$(ls -d "$GAME"/Data/????/ 2>/dev/null | head -1)" 2>/dev/null)"
CHAT_CP="$(grep -sE '^CHAT_CP=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "$GLOC" = "ruRU" ] || [ "$CHAT_CP" = "1251" ]; then
  export LANG=ru_RU.UTF-8
  ACP=1251; OEMCP=866; MACCP=10007
else
  case "$GLOC" in
    deDE) export LANG=de_DE.UTF-8; ACP=1252; OEMCP=850; MACCP=10000 ;;
    frFR) export LANG=fr_FR.UTF-8; ACP=1252; OEMCP=850; MACCP=10000 ;;
    esES|esMX) export LANG=es_ES.UTF-8; ACP=1252; OEMCP=850; MACCP=10000 ;;
    zhCN) export LANG=zh_CN.UTF-8; ACP=936; OEMCP=936; MACCP=10008 ;;
    zhTW) export LANG=zh_TW.UTF-8; ACP=950; OEMCP=950; MACCP=10002 ;;
    koKR) export LANG=ko_KR.UTF-8; ACP=949; OEMCP=949; MACCP=10003 ;;
    *)    export LANG=en_US.UTF-8; ACP=1252; OEMCP=437; MACCP=10000 ;;
  esac
fi
export LC_ALL="$LANG"
NLSKEY='HKLM\SYSTEM\CurrentControlSet\Control\Nls\CodePage'
# Read from the prefix's registry file, not `wine reg query`: that starts wine
# and a wineserver only to read one value, ~1 s before every Play. The file is
# taken to be current: this script is the only writer of the codepage, and its
# reg add below is followed by a wineserver -k whose saved file the next
# session already has to load the new value from (not a documented wine
# guarantee — that working in the game is the evidence). Wine
# writes the key as ControlSet001 (CurrentControlSet is a link to it), with its
# own capitalisation, so the match ignores case. No file or no value: ask wine.
CUR_ACP="$(P='[system\\controlset001\\control\\nls\\codepage]' awk '
  BEGIN { p = ENVIRON["P"] }
  /^\[/ { in_key = (index(tolower($0), p) == 1); next }
  in_key && /^"ACP"="/ { v = $0; sub(/^"ACP"="/, "", v); sub(/".*/, "", v); print v; exit }
' "$RES/prefix/system.reg" 2>/dev/null)"
[ -n "$CUR_ACP" ] || CUR_ACP="$("$LOADER" reg query "$NLSKEY" /v ACP 2>/dev/null | tr -d '\r' | awk '/^[[:space:]]*ACP/ {print $NF}' | tail -1)"
if [ "$CUR_ACP" != "$ACP" ]; then
  "$LOADER" reg add "$NLSKEY" /v ACP   /t REG_SZ /d "$ACP"   /f >/dev/null 2>&1
  "$LOADER" reg add "$NLSKEY" /v OEMCP /t REG_SZ /d "$OEMCP" /f >/dev/null 2>&1
  "$LOADER" reg add "$NLSKEY" /v MACCP /t REG_SZ /d "$MACCP" /f >/dev/null 2>&1
  # the system codepage is baked in per wineserver session — force a fresh one
  "$RES/wine/bin/wineserver" -k >/dev/null 2>&1 || true
  sleep 1
fi
cd "$GAME" || exit 1
GAME_VERSION="$(grep -sE '^GAME_VERSION=' "$RES/launcher.conf" | cut -d= -f2)"
[ -n "$GAME_VERSION" ] || GAME_VERSION="$("$RES/bin/wow-game-version" "$GAME" 2>/dev/null || true)"
# vanilla: the WDB server-data cache goes stale and causes crashes — clear it
[ "$GAME_VERSION" = "1.12" ] && rm -rf "$GAME/WDB"
# The entrypoint, from the one place that decides it. --exe is the cheap mode:
# it skips the executable scan the full profile does. A vanilla-tweaks-generated
# executable still wins when the user created one.
EXE="$GAME/$("$RES/bin/wow-client-profile" --exe "$GAME")"
[ -f "$GAME/WoW_tweaked.exe" ] && EXE="$GAME/WoW_tweaked.exe"
# Auto-match the game resolution to the current display, unless disabled in launcher.conf
AUTO=$(grep -sE '^AUTO_RES=' "$RES/launcher.conf" | cut -d= -f2)
if [ "${AUTO:-1}" = "1" ]; then
  "$RES/bin/wow-settings" auto >> "$LOG.settings" 2>&1 || true
fi
# DXVK's cursor at Retina size. In RetinaMode wine hands the game's cursor
# bitmap to macOS at half a point per pixel: half the size it should be. MTLd3D
# doubles it itself (mtld3d.conf cursor.scale = auto); D9VK only when dxvk.conf
# (read from the working directory, the game's) sets enlargeHardwareCursor —
# a key of the WoWSilicon 3.2.2 payload's build, which older builds ignore.
# Only that one line is ours: any other line there is kept as it is, and the
# file goes away when our line was all it held.
CURSOR_RE='^[[:space:]]*d3d9\.enlargeHardwareCursor[[:space:]]*='
KEEP="$(grep -svE "$CURSOR_RE" "$GAME/dxvk.conf" || true)"
if [ "$("$RES/bin/wow-settings" __retina-have 2>/dev/null)" = Y ]; then
  { [ -z "$KEEP" ] || printf '%s\n' "$KEEP"; echo 'd3d9.enlargeHardwareCursor = 2'; } > "$GAME/dxvk.conf"
elif [ -n "$KEEP" ]; then
  printf '%s\n' "$KEEP" > "$GAME/dxvk.conf"
else
  rm -f "$GAME/dxvk.conf"
fi
nohup "$LOADER" "$EXE" > "$LOG" 2>&1 &
disown
# Move the game window to the chosen display once it appears (needs Accessibility)
RECT="$(grep -sE '^DISPLAY_RECT=' "$RES/launcher.conf" | cut -d= -f2)"
if [ -n "$RECT" ]; then
  (
    DX="${RECT%%,*}"; R2="${RECT#*,}"
    DY="${R2%%,*}"; R3="${R2#*,}"
    DW="${R3%%,*}"; DH="${R3#*,}"
    for _ in $(seq 1 45); do
      sleep 2
      MOVED=$(osascript 2>/dev/null <<OSA
tell application "System Events"
  set moved to "no"
  repeat with p in (application processes)
    try
      repeat with w in windows of p
        if name of w is "World of Warcraft" then
          set position of w to {$DX, $DY}
          set size of w to {$DW, $DH}
          set moved to "yes"
        end if
      end repeat
    end try
  end repeat
  return moved
end tell
OSA
)
      [ "$MOVED" = "yes" ] && break
    done
  ) >> "$LOG.mover" 2>&1 &
  disown
fi
exit 0

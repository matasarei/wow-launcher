#!/bin/bash
# Install a WoW 3.3.5a client into the wrapper and apply the Apple Silicon patch kit.
# Usage: wow-install-client /path/to/client
set -e
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
KIT="$RES/patch-kit"
LOADER="$RES/wine/bin/wine"
export WINEPREFIX="$RES/prefix" WINEDEBUG=-all
SRC="$1"
DEST="$RES/games/main"
[ -n "$SRC" ] || { echo "usage: wow-install-client /path/to/client"; exit 1; }
# validate the source thoroughly BEFORE touching any existing install
[ -f "$SRC/Wow.exe" ] || { echo "not a WoW client (no Wow.exe in $SRC)"; exit 1; }
[ -d "$SRC/Data" ]   || { echo "not a WoW client (no Data folder in $SRC)"; exit 1; }
for mpq in common.MPQ common-2.MPQ expansion.MPQ lichking.MPQ patch.MPQ patch-2.MPQ; do
  [ -f "$SRC/Data/$mpq" ] || { echo "incomplete client: Data/$mpq is missing — nothing was changed"; exit 1; }
done
SRC_LOCALE="$(basename "$(ls -d "$SRC"/Data/????/ 2>/dev/null | head -1)" 2>/dev/null)"
[ -n "$SRC_LOCALE" ] || { echo "incomplete client: no locale folder in Data — nothing was changed"; exit 1; }
# never install from inside the wrapper itself (rm -rf below would destroy the source)
SRC_REAL="$(cd "$SRC" && pwd -P)"
GAMES_REAL="$(cd "$RES" && pwd -P)/games"
case "$SRC_REAL/" in
  "$GAMES_REAL"/*) echo "the source is the installed game itself — choose the original client folder"; exit 1 ;;
esac
if [ -n "$(ls "$RES/games" 2>/dev/null)" ]; then
  echo "replacing the existing game..."
  rm -rf "$RES/games"/*
fi
mkdir -p "$RES/games"
echo "copying client (this can take a few minutes)..."
ditto "$SRC" "$DEST"
echo "applying patch kit..."
mkdir -p "$DEST/mods"
cp "$KIT/d3d9.dll" "$KIT/libDllLdr.dll" "$KIT/dlls.txt" "$DEST/"
cp "$KIT/mods/"* "$DEST/mods/"
ditto "$KIT/rosettax87" "$DEST/rosettax87"
# DivxDecoder.dll: prefer the kit's patched copy (identical across all 3.3.5a-12340
# clients); with a fresh kit, patch live via wine (libDllLdr's PatchDivxDecoder).
if [ -f "$KIT/DivxDecoder.dll.patched" ] && cmp -s "$DEST/DivxDecoder.dll" "$KIT/DivxDecoder.dll.orig"; then
  cp "$DEST/DivxDecoder.dll" "$DEST/DivxDecoder.dll.bak"
  cp "$KIT/DivxDecoder.dll.patched" "$DEST/DivxDecoder.dll"
elif [ -f "$KIT/DivxDecoder.dll.patched" ] && cmp -s "$DEST/DivxDecoder.dll" "$KIT/DivxDecoder.dll.patched"; then
  echo "DivxDecoder.dll already patched"
else
  echo "patching DivxDecoder.dll via wine..."
  WDEST="$(cd "$DEST" && "$LOADER" winepath -w . 2>/dev/null | tr -d '\r' || true)"
  ( cd "$DEST" && "$LOADER" 'C:\windows\syswow64\rundll32.exe' "libDllLdr.dll,PatchDivxDecoder" "$WDEST" >/dev/null 2>&1 )
  "$RES/wine/bin/wineserver" -w 2>/dev/null || true
  if [ -f "$DEST/DivxDecoder.dll.bak" ] && ! cmp -s "$DEST/DivxDecoder.dll" "$DEST/DivxDecoder.dll.bak"; then
    echo "DivxDecoder.dll patched"
    # stash references so future installs/verifies are instant
    [ -f "$KIT/DivxDecoder.dll.orig" ]    || cp "$DEST/DivxDecoder.dll.bak" "$KIT/DivxDecoder.dll.orig"
    [ -f "$KIT/DivxDecoder.dll.patched" ] || cp "$DEST/DivxDecoder.dll" "$KIT/DivxDecoder.dll.patched"
  else
    echo "WARNING: DivxDecoder.dll patch did not apply — performance hooks will be INACTIVE"
  fi
fi
# Wow.exe icon patch (cosmetic): use kit references when present, else apply the
# repo's binary diff via the system bspatch (checksum-guarded on both sides).
# Diffs are named wow-icon-<input md5>-<output md5>.bsdiff; pick by checksum.
CUR_MD5="$(md5 -q "$DEST/Wow.exe")"
ICON_DONE=0
if [ -f "$KIT/Wow.exe.orig" ] && cmp -s "$DEST/Wow.exe" "$KIT/Wow.exe.orig"; then
  cp "$DEST/Wow.exe" "$DEST/Wow.exe.icon-backup"
  cp "$KIT/Wow.exe.icon-patched" "$DEST/Wow.exe"
  echo "Wow.exe icon patched (from kit)"
  ICON_DONE=1
elif [ -x /usr/bin/bspatch ]; then
  for D in "$KIT"/wow-icon-*.bsdiff; do
    [ -f "$D" ] || continue
    B="$(basename "$D" .bsdiff)"; B="${B#wow-icon-}"
    IN_MD5="${B%%-*}"; OUT_MD5="${B#*-}"
    [ "$CUR_MD5" = "$IN_MD5" ] || continue
    /usr/bin/bspatch "$DEST/Wow.exe" "$DEST/Wow.exe.icon-new" "$D"
    if [ "$(md5 -q "$DEST/Wow.exe.icon-new" 2>/dev/null)" = "$OUT_MD5" ]; then
      cp "$DEST/Wow.exe" "$DEST/Wow.exe.icon-backup"
      mv "$DEST/Wow.exe.icon-new" "$DEST/Wow.exe"
      chmod +x "$DEST/Wow.exe"
      echo "Wow.exe icon patched"
      ICON_DONE=1
    else
      rm -f "$DEST/Wow.exe.icon-new"
    fi
    break
  done
fi
[ "$ICON_DONE" = 1 ] || echo "icon patch skipped (unknown Wow.exe build — cosmetic only)"
# Reset display/compat settings to the known-good baseline — imported clients
# carry Config.wtf from other machines with incompatible window/renderer settings.
CFGD="$DEST/WTF/Config.wtf"
mkdir -p "$DEST/WTF"; touch "$CFGD"
seed() {
  if grep -qiE "^SET $1 " "$CFGD"; then sed -i '' -E "s|^SET $1 .*|SET $1 \"$2\"|" "$CFGD"
  else printf 'SET %s "%s"\n' "$1" "$2" >> "$CFGD"; fi
}
seed gxWindow 1              # borderless window
seed gxMaximize 1            # fill the screen (resolution itself is auto-set at launch)
seed hwDetect 0              # don't let the game re-detect and override settings
seed gxRefresh 60
seed gxMultisampleQuality 0.000000
seed videoOptionsVersion 3   # mark video setup as done — prevents first-run re-detection
seed M2UseShaders 0          # known-good under the DXVK/libSiliconPatch stack
seed M2UsePixelShaders 0
seed M2UseThreadedBlood 0
seed gxFixLag 0
seed movie 0                 # skip intro movies
seed readTOS 1
seed readEULA 1
grep -qE '^GAME=main$' "$RES/launcher.conf" 2>/dev/null || {
  grep -vE '^GAME=' "$RES/launcher.conf" 2>/dev/null > "$RES/launcher.conf.tmp" || true
  printf 'GAME=main\n' >> "$RES/launcher.conf.tmp"
  mv "$RES/launcher.conf.tmp" "$RES/launcher.conf"
}
echo "display settings reset to defaults"
# Fonts (the game loads Fonts/*.TTF over its MPQ fonts):
# - Cyrillic input mode (ruRU client, or CHAT_CP=1251): glyph-remapped fonts
#   from the patch kit — the client inserts typed CP1251 bytes as Latin-1
#   codepoints, and these fonts render those positions as Cyrillic (the
#   classic community fix). Proper Unicode Cyrillic still renders normally.
# - Otherwise: plain Arial from macOS so received Cyrillic isn't boxes.
# Auto-enable the Cyrillic input layer when the Mac has a Russian keyboard
# layout and CHAT_CP was not set explicitly (set CHAT_CP= empty to opt out).
if ! grep -qsE '^CHAT_CP=' "$RES/launcher.conf" \
   && defaults read ~/Library/Preferences/com.apple.HIToolbox.plist AppleEnabledInputSources 2>/dev/null | grep -qi russian; then
  printf 'CHAT_CP=1251\n' >> "$RES/launcher.conf"
  echo "Russian keyboard layout detected — Cyrillic chat input enabled"
fi
CHAT_CP="$(grep -sE '^CHAT_CP=' "$RES/launcher.conf" | cut -d= -f2)"
SUP="/System/Library/Fonts/Supplemental"
if [ "$SRC_LOCALE" = "ruRU" ] || [ "$CHAT_CP" = "1251" ]; then
  mkdir -p "$DEST/Fonts"
  if [ -n "$(ls "$KIT/fonts-client" 2>/dev/null)" ]; then
    cp "$KIT/fonts-client/"* "$DEST/Fonts/"
    echo "installed Cyrillic input fonts (original client fonts)"
  elif python3 "$RES/bin/wow-client-fonts.py" "$DEST" "$DEST/Fonts" 2>/dev/null; then
    mkdir -p "$KIT/fonts-client" && cp "$DEST/Fonts/"* "$KIT/fonts-client/"
    echo "installed Cyrillic input fonts (extracted from the client's own fonts)"
  else
    rmdir "$DEST/Fonts" 2>/dev/null || true
    echo "NOTE: Cyrillic fonts unavailable — install a ruRU client once (its original fonts are then reused for any client)"
  fi
elif [ ! -d "$DEST/Fonts" ] && [ -f "$SUP/Arial.ttf" ]; then
  mkdir -p "$DEST/Fonts"
  cp "$SUP/Arial.ttf"        "$DEST/Fonts/FRIZQT__.TTF"
  cp "$SUP/Arial Narrow.ttf" "$DEST/Fonts/ARIALN.TTF" 2>/dev/null || cp "$SUP/Arial.ttf" "$DEST/Fonts/ARIALN.TTF"
  cp "$SUP/Arial Bold.ttf"   "$DEST/Fonts/MORPHEUS.TTF" 2>/dev/null || cp "$SUP/Arial.ttf" "$DEST/Fonts/MORPHEUS.TTF"
  cp "$SUP/Arial Bold.ttf"   "$DEST/Fonts/skurri.ttf"   2>/dev/null || cp "$SUP/Arial.ttf" "$DEST/Fonts/skurri.ttf"
  echo "installed Cyrillic-capable display fonts (delete the game's Fonts folder to restore the original look)"
fi
echo "game installed"

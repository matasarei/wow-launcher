#!/bin/bash
# Install any WoW client into the wrapper and apply the parts of the Apple
# Silicon patch kit that can actually work on it. Usage:
#   wow-install-client /path/to/client
# The classic three (3.3.5a, 2.4.3, 1.12) get the full treatment; anything else
# gets whatever wow-client-profile says applies, down to nothing at all.
set -e
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
KIT="$RES/patch-kit"
BIN="$RES/bin"
LOADER="$RES/wine/bin/wine"
ROSETTA_OK=1
if WHY="$("$BIN/wow-check-rosetta")"; then :; else ROSETTA_OK=0; echo "$WHY"; fi
export WINEPREFIX="$RES/prefix" WINEDEBUG=-all
USER_HOME="$HOME"   # the real one, for the keyboard-layout check below
export HOME="$("$RES/bin/wow-wine-home" || echo "$HOME")"   # not the user's: wine leaves ~/Wine there (see wow-wine-home)
# the Z: drive link is stripped at build time (absolute symlinks break codesign)
[ -e "$RES/prefix/dosdevices/z:" ] || ln -sf / "$RES/prefix/dosdevices/z:" 2>/dev/null
# --updating: the import is an update installing itself (see wow-update), so the
# source app is the launcher running this — only its game has to be idle.
UPDATING=0
[ "$1" = --updating ] && { UPDATING=1; shift; }
SRC="$1"
DEST="$RES/games/main"
[ -n "$SRC" ] || { echo "usage: wow-install-client [--updating] /path/to/client"; exit 1; }
# A previous copy of this app (wow-install-client /Applications/Old.app) is the
# best source there is: its game is already patched and its kit holds the
# references this one would otherwise rebuild. It is checked before anything
# here changes, and only ever read. 2.1 is the floor: the first release with
# this bundle identifier (1.0/2.0 were local.wow335.singleapp, 3.3.5a-only).
MIGRATE=0
case "$SRC" in
  *.app|*.app/)
    OLD="$(cd "$SRC" 2>/dev/null && pwd -P)" || { echo "no such app: $SRC"; exit 1; }
    GIVEN="$(cd "$SRC" && pwd -L)"   # as the caller spelled it (see the running check)
    OLD_NAME="$(basename "$OLD" .app)"
    # (PlistBuddy fails on a missing file or key — an empty answer here, not an exit)
    plist() { [ -f "$OLD/Contents/Info.plist" ] && /usr/libexec/PlistBuddy -c "Print :$1" "$OLD/Contents/Info.plist" 2>/dev/null || true; }
    OLD_VER="$(plist CFBundleShortVersionString)"
    case "$(plist CFBundleIdentifier)" in
      io.github.matasarei.wow-launcher) ;;
      local.wow335.singleapp) echo "$OLD_NAME ${OLD_VER:-(no version)} is too old to import from — WoW Launcher 2.1 or later is needed"; exit 1 ;;
      *) echo "not a WoW Launcher app: $OLD_NAME"; exit 1 ;;
    esac
    MAJ="${OLD_VER%%.*}"; MIN="${OLD_VER#"$MAJ"}"; MIN="${MIN#.}"; MIN="${MIN%%.*}"
    case "$MAJ" in ''|*[!0-9]*) MAJ=0 ;; esac
    case "$MIN" in ''|*[!0-9]*) MIN=0 ;; esac
    if [ "$MAJ" -lt 2 ] || { [ "$MAJ" = 2 ] && [ "$MIN" -lt 1 ]; }; then
      echo "$OLD_NAME ${OLD_VER:-(no version)} is too old to import from — WoW Launcher 2.1 or later is needed"; exit 1
    fi
    [ "$OLD" = "$(cd "$APP" && pwd -P)" ] && { echo "that is this launcher itself — choose the previous app"; exit 1; }
    OLD_RES="$OLD/Contents/Resources"
    OLD_GAME="$(grep -sE '^GAME=' "$OLD_RES/launcher.conf" | head -1 | cut -d= -f2-)"
    SRC="$OLD_RES/games/${OLD_GAME:-main}"
    [ -n "$(ls "$SRC" 2>/dev/null)" ] || { echo "$OLD_NAME has no game installed — nothing to import"; exit 1; }
    # the old launcher or its game still running: WTF and Cache are written on
    # exit, and its wineserver may hold files open mid-copy. Processes show the
    # path they were started by, which may be a symlinked one (/tmp for
    # /private/tmp), so both spellings count — and Wine lists the game itself as
    # Z:\…\Wow.exe, so backslashes read as slashes. (Listed first, so the grep
    # does not find its own command line.)
    PS="$(ps -axww -o command= | tr '\\' /)"
    if [ "$UPDATING" = 1 ]; then
      # only the game: the launcher doing the updating reads its display
      # settings through wine, and that wineserver lingers for seconds
      set -- "$OLD/Contents/Resources/games/" "$GIVEN/Contents/Resources/games/"
      BUSY="the game from $OLD_NAME is still running — quit it first"
    else
      set -- "$OLD/Contents/" "$GIVEN/Contents/"
      BUSY="$OLD_NAME is still running — quit it and its game first"
    fi
    for P in "$@"; do
      printf '%s\n' "$PS" | grep -qF -- "$P" && { echo "$BUSY"; exit 1; }
    done
    MIGRATE=1
    echo "importing from $OLD_NAME $OLD_VER"
    ;;
esac
# Fingerprint the source BEFORE touching any existing install: what the client
# is decides which of the checks below apply and which patches get copied.
read_profile() {
  PROFILE="$("$BIN/wow-client-profile" "$SRC")"
  V="$(prof VERSION)";       FAMILY="$(prof FAMILY)";      BUILD="$(prof BUILD)"
  EXE="$(prof EXE)";         SRC_LOCALE="$(prof LOCALE)";  CONFIDENCE="$(prof CONFIDENCE)"
  PATCHES="$(prof PATCHES)"; REQUESTED="$(prof PATCHES_REQUESTED)"
  CAP_LOADER="$(prof CAP_LOADER)"; CAP_DXVK="$(prof CAP_DXVK)";   CAP_SILICON="$(prof CAP_SILICON)"
  CAP_ICON="$(prof CAP_ICON)";     CAP_TWEAKS="$(prof CAP_TWEAKS)"; CAP_CVARS="$(prof CAP_CVARS)"
}
prof() { printf '%s\n' "$PROFILE" | grep -E "^$1=" | cut -d= -f2-; }
read_profile
[ -f "$SRC/$EXE" ] || { echo "not a WoW client (no game executable in $SRC)"; exit 1; }
[ -d "$SRC/Data" ] || { echo "not a WoW client (no Data folder in $SRC)"; exit 1; }
# Structure checks only for the clients we know the shape of. A Cataclysm or
# Legion client is not incomplete just because it has no lichking.MPQ.
case "$FAMILY" in
  wotlk)   CORE_MPQS="common.MPQ common-2.MPQ expansion.MPQ lichking.MPQ patch.MPQ patch-2.MPQ"; NEED_LOCALE=1 ;;
  tbc)     CORE_MPQS="common.MPQ expansion.MPQ patch.MPQ";                                        NEED_LOCALE=1 ;;
  vanilla) CORE_MPQS="dbc.MPQ interface.MPQ model.MPQ texture.MPQ";                               NEED_LOCALE=0 ;;
  *)       CORE_MPQS="";                                                                          NEED_LOCALE=0 ;;
esac
for mpq in $CORE_MPQS; do
  [ -f "$SRC/Data/$mpq" ] || { echo "incomplete $V client: Data/$mpq is missing — nothing was changed"; exit 1; }
done
if [ "$NEED_LOCALE" = 1 ] && [ -z "$SRC_LOCALE" ]; then
  echo "incomplete $V client: no locale folder in Data — nothing was changed"; exit 1
fi
# never install from inside the wrapper itself (rm -rf below would destroy the source)
SRC_REAL="$(cd "$SRC" && pwd -P)"
GAMES_REAL="$(cd "$RES" && pwd -P)/games"
case "$SRC_REAL/" in
  "$GAMES_REAL"/*) echo "the source is the installed game itself — choose the original client folder"; exit 1 ;;
esac
echo "detected client version: $V"
[ "$CONFIDENCE" = guess ] \
  && echo "NOTE: this client is not one the launcher recognises — installing it as it is"
if [ -n "$(ls "$RES/games" 2>/dev/null)" ]; then
  echo "replacing the existing game..."
  rm -rf "$RES/games"/*
fi
mkdir -p "$RES/games"
echo "copying client..."
# COPY lines are progress for the launcher's install pane (see wow-copy)
"$BIN/wow-copy" "$SRC" "$DEST"
# From a previous app the player's own choices come along — once the copy has
# made it, so a failed one changes nothing else. The patch level decides what
# the profile offers, so it is read again after. What the game is
# and where it sits on screen are this install's to work out.
if [ "$MIGRATE" = 1 ]; then
  KEYS='PATCHES|SILICON|CHAT_CP|RENDERER|SPATIAL_AUDIO|NORMALIZE_AUDIO|CLOSE_ON_PLAY|X87|RETINA'
  KEYS="$KEYS|UPDATE_CHECK|UPDATE_CHECKED|UPDATE_SKIP"   # see wow-update
  CARRY="$(grep -sE "^($KEYS)=" "$OLD_RES/launcher.conf" || true)"
  # SILICON= is the pre-2.4 PATCHES: carried only when there is nothing newer
  printf '%s\n' "$CARRY" | grep -qE '^PATCHES=' && CARRY="$(printf '%s\n' "$CARRY" | grep -vE '^SILICON=')"
  grep -svE "^($KEYS)=" "$RES/launcher.conf" > "$RES/launcher.conf.tmp" || true
  [ -n "$CARRY" ] && printf '%s\n' "$CARRY" >> "$RES/launcher.conf.tmp"
  mv "$RES/launcher.conf.tmp" "$RES/launcher.conf"
  [ -n "$CARRY" ] && echo "settings kept: $(printf '%s\n' "$CARRY" | cut -d= -f1 | tr '\n' ' ' | sed 's/ $//')"
  read_profile
fi
# The old kit's self-populated references (the patched Divx DLLs, the icon-
# patched Wow.exe, the Cyrillic font stash) came out of the same WoWSilicon
# payload, so they are this kit's too. Never over one this kit already has, and
# a font stash only when it is of the current remap (pre-2.3 ones are not).
if [ "$MIGRATE" = 1 ]; then
  for F in "$OLD_RES/patch-kit"/DivxDecoder.dll.*.orig "$OLD_RES/patch-kit"/DivxDecoder.dll.*.patched \
           "$OLD_RES/patch-kit"/DivxTac.dll.*.orig     "$OLD_RES/patch-kit"/DivxTac.dll.*.patched \
           "$OLD_RES/patch-kit/Wow.exe.orig"            "$OLD_RES/patch-kit/Wow.exe.icon-patched"; do
    [ -f "$F" ] && [ ! -e "$KIT/$(basename "$F")" ] && cp "$F" "$KIT/" && echo "kit reference imported: $(basename "$F")"
  done
  if [ -z "$(ls "$KIT/fonts-client" 2>/dev/null)" ] \
     && "$BIN/wow-client-fonts" check "$OLD_RES/patch-kit/fonts-client/"* >/dev/null 2>&1; then
    ditto "$OLD_RES/patch-kit/fonts-client" "$KIT/fonts-client" && echo "Cyrillic font stash imported"
  fi
fi
echo "applying patch kit..."
mkdir -p "$DEST/mods"
# Both are 32-bit x86: on a 64-bit client they could never be loaded at all.
[ "$CAP_DXVK" = 1 ]   && cp "$KIT/d3d9.dll" "$DEST/"
[ "$CAP_LOADER" = 1 ] && cp "$KIT/libDllLdr.dll" "$DEST/"
ditto "$KIT/rosettax87" "$DEST/rosettax87"
# Patch level (launcher.conf PATCHES=, Game pane picker; survives reinstalls):
#   all        every patch, including libSiliconPatch          (default)
#   no-silicon everything except libSiliconPatch
#   winerosetta only that DLL — the Rosetta 2 instruction shim (ARPL,
#              FCOMP ST(0),ST(0)) that lets server-pushed Warden code run
#   none       the client is left exactly as it shipped
if [ "$PATCHES" = "$REQUESTED" ]; then
  echo "patch level: $PATCHES"
else
  echo "patch level: $PATCHES (asked for '$REQUESTED', which this client cannot take)"
fi
MODS=""
if [ "$CAP_LOADER" = 1 ] && [ "$PATCHES" != none ]; then
  cp "$KIT/mods/winerosetta.dll" "$DEST/mods/"
  MODS="mods/winerosetta.dll"
fi
# libSiliconPatch (WoWSilicon's client speed hooks) ships only at PATCHES=all,
# and only for a client whose build its hardcoded addresses were written for.
if [ "$PATCHES" = all ] && [ -n "$CAP_SILICON" ]; then
  cp "$KIT/libSiliconPatch/$CAP_SILICON/libSiliconPatch.dll" "$DEST/mods/libSiliconPatch.dll"
  MODS="$MODS mods/libSiliconPatch.dll"
fi
# shellcheck disable=SC2086 — word splitting is how the list becomes one per line
if [ -n "$MODS" ]; then printf '%s\n' $MODS > "$DEST/dlls.txt"; else rm -f "$DEST/dlls.txt"; fi
# vanilla-tweaks (1.12 only): optional community exe patcher, shipped for later use
[ "$CAP_TWEAKS" = 1 ] && cp "$KIT/vanilla-tweaks.exe" "$DEST/"
# Divx DLL patch: makes the client load dlls.txt mods. Older clients ship
# DivxTac.dll instead of (or besides) DivxDecoder.dll — patch whichever exists.
# Kit references are keyed by version (the DLLs differ between client builds):
# prefer the kit's patched copy, else patch live via wine (libDllLdr entry).
patch_divx() {  # patch_divx <dll name> <libDllLdr entry>
  local DLL="$1" ENTRY="$2"
  local ORIG="$KIT/$DLL.$V.orig" PATCHED="$KIT/$DLL.$V.patched"
  [ -f "$DEST/$DLL" ] || return 0
  if [ -f "$PATCHED" ] && cmp -s "$DEST/$DLL" "$ORIG"; then
    cp "$DEST/$DLL" "$DEST/$DLL.bak"
    cp "$PATCHED" "$DEST/$DLL"
    echo "$DLL patched (from kit)"
  elif [ -f "$PATCHED" ] && cmp -s "$DEST/$DLL" "$PATCHED"; then
    echo "$DLL already patched"
  elif [ "$ROSETTA_OK" = 0 ]; then
    # wine cannot run, so the live patch would do nothing quietly; the game is
    # unplayable until Rosetta is back anyway, and the copy stays installable.
    echo "WARNING: $DLL not patched — Rosetta 2 is missing, so wine cannot run"
  else
    echo "patching $DLL via wine..."
    ( cd "$DEST" && "$LOADER" 'C:\windows\syswow64\rundll32.exe' "libDllLdr.dll,$ENTRY" "$(cd "$DEST" && "$LOADER" winepath -w . 2>/dev/null | tr -d '\r' || true)" >/dev/null 2>&1 )
    "$RES/wine/bin/wineserver" -w 2>/dev/null || true
    if [ -f "$DEST/$DLL.bak" ] && ! cmp -s "$DEST/$DLL" "$DEST/$DLL.bak"; then
      echo "$DLL patched"
      # stash references so future installs/verifies are instant
      [ -f "$ORIG" ]    || cp "$DEST/$DLL.bak" "$ORIG"
      [ -f "$PATCHED" ] || cp "$DEST/$DLL" "$PATCHED"
    else
      echo "WARNING: $DLL patch did not apply — performance hooks may be INACTIVE"
    fi
  fi
}
# From a previous app a Divx DLL whose .bak differs from it is already patched:
# patching it again would patch a patched file, so wow-verify-game --fix, at the
# end, takes it to the chosen level instead. One the old app never managed to
# patch (it installed while Rosetta was missing) gets the normal treatment.
already_patched() { [ "$MIGRATE" = 1 ] && [ -f "$DEST/$1.bak" ] && ! cmp -s "$DEST/$1" "$DEST/$1.bak"; }
already_patched DivxDecoder.dll || patch_divx DivxDecoder.dll PatchDivxDecoder
already_patched DivxTac.dll     || patch_divx DivxTac.dll     PatchDivxTac
# At PATCHES=none the client must ship unmodified — but patch first anyway, so the
# kit references and the .bak exist and switching levels later needs no reinstall.
if [ "$PATCHES" = none ]; then
  for DLL in DivxDecoder.dll DivxTac.dll; do
    [ -f "$DEST/$DLL.bak" ] || continue
    cp "$DEST/$DLL.bak" "$DEST/$DLL"; echo "$DLL restored (no patches)"
  done
fi
# From a previous app Wow.exe may already carry the icon, and the diffs only
# go one way: verify --fix, at the end, converges it from Wow.exe.icon-backup.
if [ "$MIGRATE" = 0 ]; then
# Wow.exe icon patch (cosmetic): use kit references when present, else apply the
# repo's binary diff via the system bspatch (checksum-guarded on both sides).
# Diffs are named wow-icon-<input md5>-<output md5>.bsdiff; pick by checksum.
CUR_MD5="$(md5 -q "$DEST/$EXE")"
ICON_DONE=0
case "$PATCHES" in all|no-silicon) ICON_WANTED=1 ;; *) ICON_WANTED=0 ;; esac
# the diffs are keyed to Blizzard's Wow.exe; a custom entrypoint has no match
[ "$EXE" = "Wow.exe" ] || { ICON_DONE=1; echo "icon patch skipped ($EXE is a custom client entrypoint)"; }
if [ "$ICON_DONE" = 1 ]; then :
elif [ "$ICON_WANTED" = 0 ]; then
  ICON_DONE=1; echo "icon patch skipped (patch level: $PATCHES)"
elif [ "$CAP_ICON" = 0 ]; then
  ICON_DONE=1; echo "icon patch skipped (unknown $EXE build — cosmetic only)"
elif [ -f "$KIT/Wow.exe.orig" ] && cmp -s "$DEST/Wow.exe" "$KIT/Wow.exe.orig"; then
  cp "$DEST/Wow.exe" "$DEST/Wow.exe.icon-backup"
  cp "$KIT/Wow.exe.icon-patched" "$DEST/Wow.exe"
  echo "Wow.exe icon patched (from kit)"
  ICON_DONE=1
elif [ -x /usr/bin/bspatch ]; then
  for D in "$KIT"/wow-icon-*.bsdiff; do
    [ -f "$D" ] || continue
    B="$(basename "$D" .bsdiff)"; B="${B#wow-icon-}"
    IN_MD5="${B%%-*}"; OUT_MD5="${B#*-}"
    [ "$CUR_MD5" = "$IN_MD5" ] || continue
    /usr/bin/bspatch "$DEST/Wow.exe" "$DEST/Wow.exe.icon-new" "$D"
    if [ "$(md5 -q "$DEST/Wow.exe.icon-new" 2>/dev/null)" = "$OUT_MD5" ]; then
      cp "$DEST/Wow.exe" "$DEST/Wow.exe.icon-backup"
      mv "$DEST/Wow.exe.icon-new" "$DEST/Wow.exe"
      chmod +x "$DEST/Wow.exe"
      echo "Wow.exe icon patched"
      ICON_DONE=1
    else
      rm -f "$DEST/Wow.exe.icon-new"
    fi
    break
  done
fi
[ "$ICON_DONE" = 1 ] || echo "icon patch skipped (unknown Wow.exe build — cosmetic only)"
fi
# Reset display/compat settings to the known-good baseline — imported clients
# carry Config.wtf from other machines with incompatible window/renderer settings.
# The gx* names below are the MPQ-era ones; a client that stores its settings
# some other way is left alone rather than seeded with guesses. From a previous
# app it is the player's own Config.wtf from this Mac, which is what is moving.
CFGD="$DEST/WTF/Config.wtf"
seed() {
  if grep -qiE "^SET $1 " "$CFGD"; then sed -i '' -E "s|^SET $1 .*|SET $1 \"$2\"|" "$CFGD"
  else printf 'SET %s "%s"\n' "$1" "$2" >> "$CFGD"; fi
}
if [ "$CAP_CVARS" = 1 ] && [ "$MIGRATE" = 0 ]; then
mkdir -p "$DEST/WTF"; touch "$CFGD"
seed gxWindow 1              # borderless window
seed gxMaximize 1            # fill the screen (resolution itself is auto-set at launch)
seed hwDetect 0              # don't let the game re-detect and override settings
seed gxRefresh 60
seed gxMultisampleQuality 0.000000
seed movie 0                 # skip intro movies
seed readTOS 1
seed readEULA 1
if [ "$FAMILY" = wotlk ]; then
  seed videoOptionsVersion 3   # mark video setup as done — prevents first-run re-detection
  seed M2UseShaders 0          # known-good under the DXVK/libSiliconPatch stack
  seed M2UsePixelShaders 0
  seed M2UseThreadedBlood 0
  seed gxFixLag 0
fi
fi
# record the game + what it is, and reset display/renderer settings to defaults
# (the renderer and a hand-made Retina choice stay when they came from a previous app)
RESET='GAME|GAME_VERSION|GAME_FAMILY|GAME_BUILD|GAME_EXE|AUTO_RES|GAME_DISPLAY|DISPLAY_RECT'
[ "$MIGRATE" = 1 ] || RESET="$RESET|RENDERER|RETINA"
grep -vE "^($RESET)=" "$RES/launcher.conf" 2>/dev/null > "$RES/launcher.conf.tmp" || true
# AUTO_RES=0 is the player's choice too (resolution managed by hand) — kept from
# a previous app, but only where there are gx* cvars to auto-match at all
AUTO="$CAP_CVARS"
[ "$MIGRATE" = 1 ] && [ "$CAP_CVARS" = 1 ] \
  && [ "$(grep -sE '^AUTO_RES=' "$OLD_RES/launcher.conf" | cut -d= -f2)" = 0 ] && AUTO=0
# GAME_EXE lets the GUI recognise the running game by name — a repack may call
# its executable anything, and pgrep needs to know what to look for.
printf 'AUTO_RES=%s\nGAME=main\nGAME_VERSION=%s\nGAME_FAMILY=%s\nGAME_BUILD=%s\nGAME_EXE=%s\n' \
  "$AUTO" "$V" "$FAMILY" "$BUILD" "$EXE" >> "$RES/launcher.conf.tmp"
mv "$RES/launcher.conf.tmp" "$RES/launcher.conf"
if [ "$MIGRATE" = 1 ]; then
  # resolution and RetinaMode follow this screen in verify --fix, at the end
  # (`retina auto` here would also forget a Retina choice made by hand)
  echo "game settings kept from $OLD_NAME"
elif [ "$CAP_CVARS" = 1 ]; then
  # match resolution + retina mode to the current display right away
  "$BIN/wow-settings" auto >/dev/null 2>&1 || true
  echo "display settings reset to defaults"
else
  # RetinaMode is a wine-prefix setting, not a client cvar — verify checks it for
  # every client, so a fresh wrapper must not be left with it unset.
  "$BIN/wow-settings" retina auto >/dev/null 2>&1 || true
  echo "display settings left untouched (this client does not use the classic gx* settings)"
fi
# Fonts (the game loads Fonts/*.TTF over its MPQ fonts):
# - Cyrillic input mode (ruRU client, or CHAT_CP=1251): glyph-remapped fonts
#   from the patch kit — the client inserts typed CP1251 bytes as Latin-1
#   codepoints, and these fonts render those positions as Cyrillic (the
#   classic community fix). Proper Unicode Cyrillic still renders normally.
# Auto-enable the Cyrillic input layer when the Mac has a Russian keyboard
# layout and CHAT_CP was not set explicitly (set CHAT_CP= empty to opt out).
if ! grep -qsE '^CHAT_CP=' "$RES/launcher.conf" \
   && defaults read "$USER_HOME/Library/Preferences/com.apple.HIToolbox.plist" AppleEnabledInputSources 2>/dev/null | grep -qi russian; then
  printf 'CHAT_CP=1251\n' >> "$RES/launcher.conf"
  echo "Russian keyboard layout detected — Cyrillic chat input enabled"
fi
CHAT_CP="$(grep -sE '^CHAT_CP=' "$RES/launcher.conf" | cut -d= -f2)"
if [ "$SRC_LOCALE" = "ruRU" ] || [ "$CHAT_CP" = "1251" ]; then
  # A ruRU client is the authentic source: (re)extract when the stash is missing
  # or predates the current remap (wow-client-fonts check fails on old stashes).
  if [ "$SRC_LOCALE" = "ruRU" ] && ! "$BIN/wow-client-fonts" check "$KIT/fonts-client/"* >/dev/null 2>&1; then
    rm -rf "$KIT/fonts-client.new"
    if "$BIN/wow-client-fonts" "$DEST" "$KIT/fonts-client.new"; then
      rm -rf "$KIT/fonts-client" && mv "$KIT/fonts-client.new" "$KIT/fonts-client"
      echo "Cyrillic fonts extracted from the client and stashed"
    fi
  fi
  if [ -n "$(ls "$KIT/fonts-client" 2>/dev/null)" ]; then
    mkdir -p "$DEST/Fonts"
    cp "$KIT/fonts-client/"* "$DEST/Fonts/"
    echo "installed Cyrillic input fonts (original client fonts, CP1251 remap)"
  else
    echo "NOTE: Cyrillic fonts unavailable — import a ruRU language pack (or install a ruRU client) once; its original fonts are then reused for any client"
  fi
fi
# From a previous app nothing above patched anything: verify --fix brings the
# kit files, the mod set, the Divx DLL and the icon to the chosen level, from
# the .bak / icon-backup originals the old app left beside them.
if [ "$MIGRATE" = 1 ]; then
  "$BIN/wow-verify-game" --fix | grep -E '\(fixed\)|^(FAIL|WARN):' || true
  echo "game installed ($V), imported from $OLD_NAME $OLD_VER"
else
  echo "game installed ($V)"
fi

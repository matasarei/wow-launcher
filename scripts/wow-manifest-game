#!/bin/bash
# Record a SHA-256 manifest of the game's immutable files (.manifest.sha256).
# Usage: wow-manifest-game [GameName]   (default: the active game)
set -e
APP="$(cd "$(dirname "$0")/../../.." && pwd)"
RES="$APP/Contents/Resources"
if [ -n "$1" ]; then G="$RES/games/$1"; else
  GAME_NAME="$(grep -sE '^GAME=' "$RES/launcher.conf" | head -1 | cut -d= -f2-)"
  if [ -n "$GAME_NAME" ] && [ -d "$RES/games/$GAME_NAME" ]; then G="$RES/games/$GAME_NAME"; else G="$RES/game"; fi
fi
[ -d "$G" ] || { echo "no game at $G"; exit 1; }
cd "$G"
{
  find Data -type f \( -name '*.MPQ' -o -name '*.mpq' \) | sort
  for f in Wow.exe DivxDecoder.dll d3d9.dll libDllLdr.dll; do [ -f "$f" ] && echo "$f"; done
  [ -d mods ] && find mods -type f -name '*.dll' | sort
} | while IFS= read -r f; do shasum -a 256 "$f"; done > .manifest.sha256
echo "manifest: $(grep -c . .manifest.sha256) files recorded"
